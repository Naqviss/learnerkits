# Public production origin used for canonical URLs, hreflang, sitemap and checkout redirects.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional ISO date used by sitemap lastmod. Update when indexed educational content changes.
# NEXT_PUBLIC_CONTENT_UPDATED_AT=2026-09-19

# Optional IndexNow key. Publish the matching key file at the site root before use.
# INDEXNOW_KEY=replace_with_indexnow_key

# Public contact shown on About/Contact/Privacy pages. Activate this mailbox before launch.
NEXT_PUBLIC_CONTACT_EMAIL=contactus@learnerkits.com

# AdSense publisher ID without the "ca-" prefix. Generates the verification meta tag and ads.txt.
# Do not leave a sample ID enabled in production.
# ADSENSE_PUBLISHER_ID=pub-0000000000000000

# Recommended: Stripe-hosted Checkout for one-time donations. Keep this server-only.
STRIPE_SECRET_KEY=sk_live_replace_me
DONATION_CURRENCY=usd

# Optional fallback when Stripe API checkout is not configured.
# Example: a hosted Stripe Payment Link or another trusted hosted donation page.
# DONATION_HOSTED_URL=https://buy.stripe.com/replace_me

# Server-only contact form credentials. Never prefix these with NEXT_PUBLIC_.
# Apply supabase/migrations/202610030001_contact_messages.sql first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy alternative to SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Optional Google sign-in through Supabase Auth (see README "Google sign-in").
# These are PUBLIC browser values: use the publishable (or legacy anon) key, never the secret key.
# Leave unset to hide the sign-in button.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# LearnerKits Premium with Paddle (see README "LearnerKits Premium"). Requires Google sign-in above and
# supabase/migrations/202611090001_premium_subscriptions.sql. Server-only except the NEXT_PUBLIC flag.
# Set to true only after checkout and the webhook are configured; it shows the Premium UI.
# NEXT_PUBLIC_PREMIUM_ENABLED=true
# One switch picks the Paddle environment: true = sandbox (test cards), false = live (real payments).
# `npm run deploy` uploads all PADDLE_* values to Cloudflare; `npm run check:paddle` verifies them.
PADDLE_TEST_MODE=true
# PADDLE_SANDBOX_API_KEY=pdl_sdbx_apikey_replace_me
# PADDLE_SANDBOX_CLIENT_TOKEN=test_replace_me
# PADDLE_SANDBOX_PRICE_ID=pri_replace_me
# PADDLE_SANDBOX_DISCOUNT_ID=dsc_replace_me
# PADDLE_SANDBOX_WEBHOOK_SECRET=pdl_ntfset_replace_me
# PADDLE_LIVE_API_KEY=pdl_live_apikey_replace_me
# PADDLE_LIVE_CLIENT_TOKEN=live_replace_me
# PADDLE_LIVE_PRICE_ID=pri_replace_me
# PADDLE_LIVE_DISCOUNT_ID=dsc_replace_me
# PADDLE_LIVE_WEBHOOK_SECRET=pdl_ntfset_replace_me

# AI tutor. Production uses the Workers AI binding in wrangler.jsonc (no key needed).
# Optional: AI_MODEL overrides the default @cf/qwen/qwen3-30b-a3b-fp8; AI_DAILY_LIMIT defaults to 40.
# For `npm run dev`, or to use another provider, set an OpenAI-compatible endpoint instead:
# AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# AI_API_KEY=replace_me
# AI_MODEL=qwen-plus
# AI_DAILY_LIMIT=40

# Admin panel at /en/admin (see README "Admin panel"). Server-only; never prefix with NEXT_PUBLIC_.
# Use long random values: the password must be at least 16 characters and the session secret at least 32.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ADMIN_USERNAME=admin-replace_me
# ADMIN_PASSWORD=replace_with_long_random_password
# ADMIN_SESSION_SECRET=replace_with_long_random_secret

# Enable ad delivery only after configuring AdSense Privacy & messaging / certified CMP
# and appropriate audience settings. Verification metadata and ads.txt work without this.
NEXT_PUBLIC_ADSENSE_ADS_ENABLED=false
