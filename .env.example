# Public production origin used for canonical URLs, hreflang, sitemap and checkout redirects.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional ISO date used by sitemap lastmod. Update when indexed educational content changes.
# NEXT_PUBLIC_CONTENT_UPDATED_AT=2026-09-19

# Optional IndexNow key. Publish the matching key file at the site root before use.
# INDEXNOW_KEY=replace_with_indexnow_key

# Public contact shown on About/Contact/Privacy pages. Activate this mailbox before launch.
NEXT_PUBLIC_CONTACT_EMAIL=contactus@leanerkits.com

# AdSense publisher ID without the "ca-" prefix. Generates the verification meta tag and ads.txt.
# Do not leave a sample ID enabled in production.
# ADSENSE_PUBLISHER_ID=pub-0000000000000000

# Recommended: Stripe-hosted Checkout for one-time donations. Keep this server-only.
STRIPE_SECRET_KEY=sk_live_replace_me
DONATION_CURRENCY=usd

# Optional fallback when Stripe API checkout is not configured.
# Example: a hosted Stripe Payment Link or another trusted hosted donation page.
# DONATION_HOSTED_URL=https://buy.stripe.com/replace_me

# Server-only contact form credentials. Never prefix these with NEXT_PUBLIC_.
# Apply supabase/migrations/202610030001_contact_messages.sql first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy alternative to SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Enable ad delivery only after configuring AdSense Privacy & messaging / certified CMP
# and appropriate audience settings. Verification metadata and ads.txt work without this.
NEXT_PUBLIC_ADSENSE_ADS_ENABLED=false
